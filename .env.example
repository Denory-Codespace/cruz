# ==============================================================================
# CRUZ — PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER COMMIT .env.local OR REAL SECRETS TO GIT.

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Free Tier / Local CLI)
# ------------------------------------------------------------------------------
# URL of your Supabase project (e.g. http://127.0.0.1:54321 or https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anonymous/Public Key (Safe for browser/mobile client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (SERVER ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# MAPS PROVIDER CONFIGURATION (Defaults to MOCK for zero-cost local dev)
# ------------------------------------------------------------------------------
# Options: MOCK | GOOGLE
NEXT_PUBLIC_MAPS_PROVIDER=MOCK
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# PAYMENT PROVIDER CONFIGURATION (Defaults to MOCK for zero-cost local dev)
# ------------------------------------------------------------------------------
# Options: MOCK | MPESA
PAYMENT_PROVIDER=MOCK
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=

# ------------------------------------------------------------------------------
# PLATFORM SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEFAULT_CURRENCY=KES
NEXT_PUBLIC_BASE_FARE_KES=150
NEXT_PUBLIC_PER_KM_FARE_KES=35
NEXT_PUBLIC_PER_MINUTE_FARE_KES=5
NEXT_PUBLIC_PLATFORM_COMMISSION_PERCENT=15
